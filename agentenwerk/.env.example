# KI-Anbieter: Mistral AI (EU, Standard). Key von https://console.mistral.ai
MISTRAL_API_KEY=
# Optional: Modell (Standard: mistral-medium-latest; stärker: mistral-large-latest)
# MISTRAL_MODEL=mistral-medium-latest

# Alternative: Claude von Anthropic
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-opus-5-5

# Optional: Port und Host (Standard: 3000, 127.0.0.1)
# PORT=3000
# HOST=127.0.0.1

# Optional: Generalschlüssel für Notfälle und Automationen (Bearer-Token für die API).
# Normal meldest du dich mit Konto an (erster Admin wird beim ersten Start angelegt).
# Läuft der Server schon im Netz, bevor es ein Konto gibt, brauchst du den Token für den ersten Admin.
# ADMIN_TOKEN=

# Optional: Öffentliche Adresse, unter der das Widget geladen wird (für den Einbau-Code)
# PUBLIC_URL=https://bots.example.de

# Optional: Speicherort für Agenten, Leads und Gespräche (Standard: ./data)
# DATA_DIR=./data

# Optional: Absender auf den Demo-Seiten des Autopiloten ("Erstellt von …")
# AGENCY_NAME=Webagentur Süd
# AGENCY_CONTACT=hallo@webagentur-sued.de

# Optional: eigener Chromium-Pfad für Website-Screenshots (sonst der von Playwright)
# CHROMIUM_PATH=/usr/bin/chromium

# Optional: E-Mail-Versand für das Akquise-Dashboard (SMTP deines Postfachs)
# SMTP_HOST=smtp.ionos.de
# SMTP_PORT=587
# SMTP_USER=anna@webagentur-sued.de
# SMTP_PASS=
# SMTP_FROM="Anna Berger <anna@webagentur-sued.de>"
# Höchstens so viele E-Mails pro 24 Stunden (Standard: 40)
# OUTREACH_DAILY_LIMIT=40
